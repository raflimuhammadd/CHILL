# Production environment
PORT=3000
NODE_ENV=production

# AWS RDS Database
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_production_db_password
DB_NAME=chill_streams_prod
DB_SSL=false
DB_POOL_LIMIT=15

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_production
JWT_EXPIRES_IN=24h

# Tencent Cloud Frontend URL
CLIENT_URL=https://your-frontend-domain.com

# Midtrans (production)
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=your_production_server_key
MIDTRANS_CLIENT_KEY=your_production_client_key

# Rate limiting (production values)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
STRICT_RATE_LIMIT_WINDOW_MS=3600000
STRICT_RATE_LIMIT_MAX_REQUESTS=3

# Optional: Docker image tags
# DOCKER_USERNAME=yourdockerhubusername
# TAG=v1.0.0