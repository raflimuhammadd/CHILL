# Development environment
PORT=3000
NODE_ENV=development

# Database (for local development)
DB_HOST=localhost
DB_PORT=3307
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=chill_streams_dev
DB_SSL=false
DB_POOL_LIMIT=10

# JWT
JWT_SECRET=your_jwt_secret_for_development
JWT_EXPIRES_IN=24h

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Midtrans (development)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_sandbox_server_key
MIDTRANS_CLIENT_KEY=your_sandbox_client_key

# Rate limiting (development values)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
STRICT_RATE_LIMIT_WINDOW_MS=3600000
STRICT_RATE_LIMIT_MAX_REQUESTS=30