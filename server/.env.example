PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_POOL_LIMIT=

JWT_SECRET=
JWT_EXPIRES_IN=

CLIENT_URL=http://localhost:5173

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ===== RATE LIMITING =====
# Customize rate limit behavior per environment
# Times in milliseconds: 1000ms = 1 second

# General rate limit (applies to all endpoints via middleware)
RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100           # 100 requests per window

# Auth rate limit (register, login, verify-email, resend-verification)
AUTH_RATE_LIMIT_WINDOW_MS=900000      # 15 minutes (same window)
AUTH_RATE_LIMIT_MAX_REQUESTS=5        # 5 requests per window (stricter)

# Strict rate limit (logout, password changes, sensitive operations)
STRICT_RATE_LIMIT_WINDOW_MS=3600000   # 1 hour
STRICT_RATE_LIMIT_MAX_REQUESTS=3      # 3 requests per window (very strict)